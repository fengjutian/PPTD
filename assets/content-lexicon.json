{
  "version": 1,
  "description": "内容词表。前端据此检测模板化标题与重复句式，Rust 侧据此写生成提示。两端共用这一份资产，词表才不会在提示与检测之间漂移。",
  "titleRules": {
    "columnNames": [
      "背景",
      "现状",
      "问题",
      "挑战",
      "机遇",
      "风险",
      "目标",
      "原则",
      "策略",
      "方案",
      "路径",
      "举措",
      "措施",
      "行动",
      "执行",
      "落地",
      "效果",
      "成效",
      "收益",
      "价值",
      "意义",
      "亮点",
      "痛点",
      "难点",
      "优势",
      "劣势",
      "对策",
      "结论",
      "总结",
      "小结",
      "概述",
      "引言",
      "前言",
      "目录",
      "绪论",
      "展望",
      "未来",
      "趋势"
    ],
    "columnSuffixes": ["分析", "概述", "介绍", "解读", "探讨", "综述", "盘点", "回顾", "梳理"],
    "bannedLeadPhrases": ["如何", "为什么", "关于", "什么是", "怎样", "怎么"],
    "emptyTailPhrases": [
      "的意义",
      "的价值",
      "的作用",
      "的重要性",
      "的影响",
      "的启示",
      "的思考",
      "的探讨",
      "的分享",
      "的解读"
    ],
    "connectors": ["以及", "与", "和", "及", "、", "，", ",", "：", ":", "／", "/"],
    "structuralTokens": [
      "以及",
      "通过",
      "基于",
      "围绕",
      "面向",
      "从",
      "到",
      "的",
      "与",
      "和",
      "及",
      "或",
      "在",
      "对",
      "为",
      "以",
      "让",
      "使",
      "把",
      "被",
      "中",
      "上",
      "下",
      "前",
      "后",
      "将"
    ],
    "repeatedPatternThreshold": 3
  },
  "argumentRules": {
    "description": "论证形式规则。每页先判断自己承担哪种论证，再选与它匹配的内容块；把变化写成并列要点，是生成稿空泛的最常见原因。提示端与检测端共用这一份表。",
    "forms": [
      {
        "id": "change",
        "label": "变化 / 趋势",
        "block": "comparison（前 → 后两栏）或 timeline，不要写成 bullet-list",
        "markers": [
          "逐步",
          "近年",
          "此前",
          "如今",
          "转向",
          "让位于",
          "先后",
          "首次",
          "不再",
          "已经",
          "越来越",
          "已高于",
          "已超过",
          "已成为"
        ]
      },
      {
        "id": "comparison",
        "label": "对比 / 选型",
        "block": "comparison",
        "markers": ["相比", "对比", "相较", "前者", "后者", "优于", "不及", "一侧", "另一侧"]
      },
      {
        "id": "sequence",
        "label": "步骤 / 流程",
        "block": "process",
        "markers": ["首先", "其次", "然后", "最后", "第一步", "第二步", "下一步"]
      },
      {
        "id": "metric",
        "label": "指标 / 构成",
        "block": "metric 或 table-data",
        "markers": ["占比", "总额", "同比", "环比", "达到", "增长", "下降", "翻倍"]
      },
      {
        "id": "list",
        "label": "并列维度",
        "block": "bullet-list",
        "markers": []
      },
      {
        "id": "judgment",
        "label": "单一判断",
        "block": "paragraph",
        "markers": []
      }
    ],
    "vagueIntensifiers": [
      "明显",
      "显著",
      "持续",
      "大幅",
      "进一步",
      "不断",
      "高度",
      "全面",
      "加快",
      "加速",
      "有效",
      "充分",
      "切实",
      "深入",
      "日益"
    ]
  },
  "punctuation": {
    "description": "中文标点规则。模型写中文时经常混用半角标点（, ; : ! ?），在半角逗号出现在中文里，整页看上去像机器排的。提示要求模型用全角，检测端按同一份表判断，两者不会各说各话。",
    "halfWidthToFullWidth": {
      ",": "，",
      ";": "；",
      ":": "：",
      "!": "！",
      "?": "？",
      "(": "（",
      ")": "）"
    },
    "pairs": {
      "(": "）",
      "【": "】",
      "《": "》",
      "“": "”"
    }
  },
  "imagePrompt": {
    "description": "配图提示词的合规规则。生成图里的文字几乎总是错的，所以提示词里不该要求画面出现文字、字母或数字；整册配图也不能太多，否则演示变成相册。提示端与检测端共用这一份表。",
    "textRequestWords": [
      "文字",
      "字母",
      "数字",
      "文案",
      "标语",
      "标题",
      "字幕",
      "海报文字",
      "招牌",
      "路牌",
      "指示牌",
      "标牌",
      "牌子",
      "海报",
      "看板",
      "写着",
      "带字",
      "字样",
      "书名",
      "商标",
      "logo",
      "水印"
    ],
    "maxImagesPerDeck": 4,
    "structuredBlockTypes": ["timeline", "comparison", "process", "table-data", "metric"]
  }
}
