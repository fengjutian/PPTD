      "痛点",
      "难点",
      "优势",
      "劣势",
      "对策",
      "结论",
      "总结",
      "小结",
      "概述",
      "引言",
      "前言",
      "目录",
      "绪论",
      "展望",
      "未来",
      "趋势"
